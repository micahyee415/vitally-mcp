# Vitally REST API — get from Settings > Integrations > REST API
VITALLY_API_KEY=your_vitally_secret_token

# Google OAuth 2.0 — "Vitally MCP" client in your-gcp-project GCP project
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Write access control — comma-separated @example.com emails
WRITE_ALLOWLIST=user@example.com

# Domain restriction
ALLOWED_DOMAIN=example.com

# Cloud Run sets PORT automatically (default 8080)
PORT=8080

# Public URL of this service (for OAuth metadata)
# SERVER_URL=https://your-service.example.com
